  "narrative": {
    "northStar": "The Graphite Instrument Panel",
    "overview": "Dish is quiet, precise, and restrained. Graphite layers organize the workspace, compact controls expose agent activity, and readable answers take priority over decoration. The interface feels refined and restrained: compact controls, a roomy composer, and recessed technical detail.\n\nThe system is a value, not a stylesheet: dark, light and two presets (warm light, low-contrast dark) are derivations of the same rules, resolved at render time. This is a record of the existing Rust/GPUI desktop implementation, not a redesign or a web theme. `src/theme.rs` is the implementation authority for shared tokens; component sources own their local exceptions. Browser-preview snippets in `.impeccable/design.json` illustrate native patterns but are not production components. This documentation was extracted from source, not validated against a fresh rendered capture.",
    "keyCharacteristics": [
      "Graphite neutrals separated by tone and hairlines.",
      "A Pi effort ladder independent of operational status.",
      "Readable proportional prose and monospace technical content.",
      "Flat surfaces at rest; structural shadows for floating UI.",
      "Compact controls, progressive disclosure, and distinct send/stop actions.",
      "Four built-in themes sharing one token vocabulary: Grafite, Papel frio, Papel quente and Grafite baixo; the effort ladder keeps Pi's hues and is re-derived for light."
    ],
    "rules": [
      {
        "name": "The Effort-Is-Not-Status Rule",
        "body": "Reasoning intensity must not stand in for execution, success, or failure. Maximum effort is coral, not an error state.",
        "section": "colors"
      },
      {
        "name": "The Reading-First Rule",
        "body": "Keep answers visually larger than the metadata and controls surrounding them; do not turn all assistant output into monospace.",
        "section": "typography"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Reserve structural shadows for floating UI; ordinary panels and transcript containers separate by tone and hairlines.",
        "section": "elevation"
      },
      {
        "name": "The Appearance-Is-A-Value Rule",
        "body": "Every colour comes from the active Theme; no component hardcodes a hex value. Dark and light are derivations of the same rules, and the user's choice (including following the desktop) applies without a restart.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** use shared theme tokens and preserve documented local component exceptions.",
      "**Do** separate reasoning intensity from operational status.",
      "**Do** prioritize readable answers and reveal technical detail on demand.",
      "**Do** retain independent send and stop controls.",
      "**Do** pair consequential status colors with words or recognizable icons.",
      "**Do** preserve tonal depth, hairline boundaries, and visible keyboard focus cues.",
      "**Do** verify contrast and status separation in every theme, not just the default.",
      "**Do** keep presets and user themes re-deriving the documented roles; a new role starts in `src/theme.rs` and this document, never in a theme file."
    ],
    "donts": [
      "**Don't** turn every section into a raised or shadowed card.",
      "**Don't** use maximum-effort coral as the failure signal.",
      "**Don't** replace proportional answer text with blanket monospace styling.",
      "**Don't** infer a mobile layout, universal focus treatment, or accessibility certification from this record.",
      "**Don't** reintroduce effort-colored transcript spines or an effort-filled send button based on outdated README descriptions.",
      "**Don't** hardcode a hex value in a component or assume the dark surface ordering holds in light."
    ]
  }
