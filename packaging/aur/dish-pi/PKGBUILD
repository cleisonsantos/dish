# Maintainer: Cleison Santos <33238294+cleisonsantos@users.noreply.github.com>

pkgname=dish-pi
_release=0.1.0-alpha.5
# O Arch proíbe hífen em pkgver; a release mantém o hífen no nome dos arquivos.
pkgver=0.1.0.alpha.5
pkgrel=1
pkgdesc='Desktop interface for the Pi coding agent'
arch=('x86_64')
url='https://github.com/cleisonsantos/dish'
license=('Apache-2.0')

# Mesmo conjunto do pacote binário, também derivado do NEEDED do build de
# referência: libc/libm -> glibc, libgcc_s -> libgcc, mais libxcb, libxkbcommon
# e libxkbcommon-x11. Wayland, EGL e Vulkan são carregados em tempo de execução.
depends=('glibc' 'libgcc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11')

# rust + pkgconf: `cargo build` e descoberta por pkg-config.
# freetype2, fontconfig e wayland: o build usa freetype-sys,
# yeslogic-fontconfig-sys e o binário wayland-scanner para gerar os protocolos.
makedepends=('rust' 'pkgconf' 'freetype2' 'fontconfig' 'wayland')

optdepends=(
  'wayland: backend Wayland (libwayland-client.so.0, libwayland-egl.so.1)'
  'libglvnd: backend EGL/OpenGL (libEGL.so.1)'
  'vulkan-icd-loader: renderizador Vulkan (libvulkan.so.1)'
  'mesa: OpenGL e Vulkan por software (lavapipe)'
  'vulkan-radeon: driver Vulkan AMD'
  'vulkan-intel: driver Vulkan Intel'
  'nvidia-utils: driver Vulkan NVIDIA'
)

conflicts=('dish-pi-bin')

source=("dish-${_release}.tar.gz::${url}/archive/refs/tags/v${_release}.tar.gz")
sha256sums=('6620362933553e672738bde6dd7252459b74bc9043cb8a85c4387550c6d8c8b6')

# As diretrizes de Rust do Arch pedem que a rede seja usada na fase de prepare
# e que o build rode sobre o que já foi baixado.
prepare() {
  cd "$srcdir/dish-${_release}" || exit 1
  cargo fetch --locked
}

build() {
  cd "$srcdir/dish-${_release}" || exit 1
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked
}

package() {
  cd "$srcdir/dish-${_release}" || exit 1

  install -Dm755 "$srcdir/target/release/dish" "$pkgdir/usr/bin/dish-pi"
  install -Dm644 assets/dish-icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/dish-pi.png"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/dish-pi.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Dish
Comment=Desktop interface for the Pi coding agent
Exec=dish-pi
Icon=dish-pi
StartupWMClass=dish
Terminal=false
Categories=Development;
EOF
  chmod 644 "$pkgdir/usr/share/applications/dish-pi.desktop"

  install -d "$pkgdir/usr/share/doc/dish-pi"
  cat > "$pkgdir/usr/share/doc/dish-pi/BUILD.json" <<EOF
{
  "package": "${pkgname}",
  "version": "${_release}",
  "target": "x86_64-unknown-linux-gnu",
  "source": "${url}/archive/refs/tags/v${_release}.tar.gz",
  "rustc": "$(rustc --version)",
  "cargo_lock_sha256": "$(sha256sum Cargo.lock | cut -d' ' -f1)"
}
EOF
  install -Dm644 README.md "$pkgdir/usr/share/doc/dish-pi/README.md"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/dish-pi/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md \
    "$pkgdir/usr/share/licenses/dish-pi/THIRD_PARTY_NOTICES.md"
  install -d "$pkgdir/usr/share/licenses/dish-pi/licenses"
  cp -a licenses/. "$pkgdir/usr/share/licenses/dish-pi/licenses/"
}
